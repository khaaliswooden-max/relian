# Dockerfile.api
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY pyproject.toml .
RUN pip install --no-cache-dir .

# Copy source code
COPY src ./src

# Copy the Meridian MUD demo corpus so GET /api/v1/assess/demo can assess it.
# DEMO_CORPUS resolves to /app/examples/demo relative to src/api/main.py; without
# this the endpoint 404s in the container.
COPY examples/demo ./examples/demo

# Expose port
EXPOSE 8000

# Command to run the application
CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
