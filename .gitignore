
# RELIAN-BENCH: held-out vectors are NEVER committed to this repository.
# They live only in the private relian-bench repo (CI deploy-key access).
**/vectors/heldout.jsonl
# The vector generator + seed live only in relian-bench-private (rule 6).
# It sits in the working tree at signing time (the manifest hashes it), so
# guard against a stray `git add -A` on the signing machine.
bench/harness/gen_vectors.py
klee-out/
bench/**/_classes/
__pycache__/
*.pyc

# deliverable archives never get committed
*.zip

# frontend build output and dependencies
node_modules/
dist/
*.tsbuildinfo
.venv/

# Test/build artifacts. `pytest` addopts writes htmlcov/ and .coverage on every
# run, and `pip install -e .` (which .github/workflows/tests.yml does) drops an
# egg-info directory in src/. None of it belongs in the tree.
htmlcov/
.coverage
.coverage.*
coverage.xml
junit.xml
*.egg-info/
.pytest_cache/
.mypy_cache/
.antlr/

# Pages artifact staging, assembled by .github/workflows/pages.yml.
_site/

# Local signing material. R4 puts key custody with the operator and says keys
# never enter this repository -- but nothing here enforced it. `keys/` turned up
# as an untracked directory on a working machine with no rule covering it, which
# left a stray `git add -A` as the only thing standing between a private key and
# a public commit. Same reasoning as the gen_vectors.py guard above: the rule
# exists because the file is present in the tree at the moment of temptation.
keys/
*.pem
*.key

# Assessment output. `python -m src.assessment.cli --out ./output/...` writes a
# report here on every demo run. It is regenerable from the corpus, and each run
# stamps its own report_hash over the tool versions that produced it, so a
# committed copy would freeze one machine's measurement as though it were the
# measurement.
output/
