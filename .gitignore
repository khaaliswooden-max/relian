
# RELIAN-BENCH: held-out vectors are NEVER committed to this repository.
# They live only in the private relian-bench repo (CI deploy-key access).
**/vectors/heldout.jsonl
# The vector generator + seed live only in relian-bench-private (rule 6).
# It sits in the working tree at signing time (the manifest hashes it), so
# guard against a stray `git add -A` on the signing machine.
bench/harness/gen_vectors.py
klee-out/
bench/**/_classes/
__pycache__/
*.pyc

# deliverable archives never get committed
*.zip

# frontend build output and dependencies
node_modules/
dist/
*.tsbuildinfo
.venv/

# Test/build artifacts. `pytest` addopts writes htmlcov/ and .coverage on every
# run, and `pip install -e .` (which .github/workflows/tests.yml does) drops an
# egg-info directory in src/. None of it belongs in the tree.
htmlcov/
.coverage
.coverage.*
coverage.xml
junit.xml
*.egg-info/
.pytest_cache/
.mypy_cache/
.antlr/
