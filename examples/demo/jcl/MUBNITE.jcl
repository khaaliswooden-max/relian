//MUBNITE  JOB (MMUD,BILL),'NIGHTLY CYCLE',CLASS=A,MSGCLASS=X,
//             REGION=4M,NOTIFY=&SYSUID
//*
//* SYNTHETIC DEMONSTRATION JCL.  NOT PRODUCTION.  NOT DERIVED FROM
//* ANY CUSTOMER OR BENCHMARK SOURCE.
//*
//* MERIDIAN MUD NIGHTLY BILLING CYCLE.  RATE, SURCHARGE, ASSEMBLE,
//* THEN POST CASH AGAINST THE CUSTOMER MASTER.
//*
//JOBLIB   DD  DSN=MMUD.PROD.LOADLIB,DISP=SHR
//*
//STEP010  EXEC PGM=MUBRATE
//SYSOUT   DD  SYSOUT=*
//SYSIN    DD  DSN=MMUD.PROD.CYCLE.EXTRACT,DISP=SHR
//*
//STEP020  EXEC PGM=MUBSURC
//SYSOUT   DD  SYSOUT=*
//HISTIN   DD  DSN=MMUD.PROD.CONSUMPTION.HIST,DISP=SHR
//*
//STEP030  EXEC PGM=MUBBILL
//SYSOUT   DD  SYSOUT=*
//PRINT    DD  SYSOUT=B
//*
//STEP040  EXEC PGM=MUBPOST,COND=(4,LT)
//CUSTMAST DD  DSN=MMUD.PROD.CUSTOMER.MASTER,DISP=SHR
//LOCKBOX  DD  DSN=MMUD.PROD.LOCKBOX.PAYMENTS,DISP=SHR
//SUSPENSE DD  DSN=MMUD.PROD.SUSPENSE,DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,2)),DCB=(RECFM=FB,LRECL=80,BLKSIZE=8000)
//AUDITRL  DD  DSN=MMUD.PROD.AUDIT.TRAIL,DISP=MOD
//SYSOUT   DD  SYSOUT=*
//
