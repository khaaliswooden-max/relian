{
    "name": "relian-frontend",
    "version": "0.1.0",
    "description": "Relian UI — legacy migration platform demo/MVP frontend",
    "type": "module",
    "main": "src/ui/index.tsx",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write \"src/ui/**/*.{ts,tsx,css}\""
    },
    "dependencies": {
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "devDependencies": {
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@vitejs/plugin-react": "^4.2.0",
        "prettier": "^3.1.0",
        "typescript": "^5.3.0",
        "vite": "^5.0.0"
    }
}
